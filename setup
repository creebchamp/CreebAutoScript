#!/bin/bash
clear
echo "======================================================"
echo "          CreebNet AutoScript Installer               "
echo "======================================================"
echo ""

# Ensure required packages are installed
echo "Updating packages..."
apt update && apt install -y curl wget jq

echo -n "Enter your License Key: "
read LICENSE_KEY

echo -n "Enter your SaaS Backend URL (e.g. your ngrok url or IP:3000): "
read BACKEND_URL

echo "Verifying license and downloading secure files..."

# Fetch the real setup script securely
curl -H "ngrok-skip-browser-warning: true" -f -sS -o /tmp/real_setup.sh "$BACKEND_URL/api/download/file/install/setup.sh?key=$LICENSE_KEY"

if [ $? -ne 0 ]; then
  echo "Error: Invalid License Key or failed to reach the backend."
  exit 1
fi

chmod +x /tmp/real_setup.sh
# Execute the real setup script and pass the key and backend URL so it can download other files securely
/tmp/real_setup.sh "$LICENSE_KEY" "$BACKEND_URL"
